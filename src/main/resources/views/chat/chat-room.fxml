<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.ChatRoomController" styleClass="chat-container">
    <padding><Insets top="10" right="15" bottom="10" left="15" /></padding>
    <spacing>10</spacing>

    <!-- Header -->
    <HBox styleClass="chat-header">
        <Label fx:id="chatTitle" text="Team Chat" styleClass="chat-title" />
        <StackPane HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Messages Area -->
    <ScrollPane fx:id="messagesScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="messages-scroll-pane">
        <VBox fx:id="messagesContainer" spacing="8" styleClass="messages-container">
            <!-- Messages will be added dynamically -->
        </VBox>
    </ScrollPane>

    <!-- Input Area -->
    <HBox spacing="10" styleClass="input-area">
        <TextField fx:id="messageField" promptText="Type a message..." HBox.hgrow="ALWAYS" styleClass="message-input" />
        <Button text="Send" onAction="#sendMessage" styleClass="send-button" />
    </HBox>
</VBox>
