<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.connexion3a36.rankup.controllers.leaderboard.LeaderboardController"
      spacing="16" styleClass="page-root">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <children>

        <!-- Header -->
        <HBox spacing="12" styleClass="card" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
            <children>
                <FontIcon iconLiteral="fas-trophy" styleClass="dashboard-stat-icon" />
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Team Leaderboard" styleClass="page-title" />
                        <Label text="Live rankings based on team scores across all games." styleClass="muted" />
                    </children>
                </VBox>
                <Label fx:id="lastUpdatedLabel" text="" styleClass="muted" />
                <Button text="🔄 Refresh" onAction="#onRefresh" styleClass="btn-secondary" />
            </children>
        </HBox>

        <!-- Top 3 podium cards -->
        <HBox fx:id="podiumBox" spacing="12">
            <children>
                <VBox fx:id="podium1" spacing="6" alignment="CENTER" styleClass="card stat-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                    <children>
                        <Label text="🥇" style="-fx-font-size:28;" />
                        <Label fx:id="rank1Name" text="—" styleClass="section-title" wrapText="true" />
                        <Label fx:id="rank1Game" text="" styleClass="muted" />
                        <Label fx:id="rank1Score" text="0 pts" styleClass="stat-value" />
                    </children>
                </VBox>
                <VBox fx:id="podium2" spacing="6" alignment="CENTER" styleClass="card stat-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                    <children>
                        <Label text="🥈" style="-fx-font-size:28;" />
                        <Label fx:id="rank2Name" text="—" styleClass="section-title" wrapText="true" />
                        <Label fx:id="rank2Game" text="" styleClass="muted" />
                        <Label fx:id="rank2Score" text="0 pts" styleClass="stat-value" />
                    </children>
                </VBox>
                <VBox fx:id="podium3" spacing="6" alignment="CENTER" styleClass="card stat-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                    <children>
                        <Label text="🥉" style="-fx-font-size:28;" />
                        <Label fx:id="rank3Name" text="—" styleClass="section-title" wrapText="true" />
                        <Label fx:id="rank3Game" text="" styleClass="muted" />
                        <Label fx:id="rank3Score" text="0 pts" styleClass="stat-value" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Filters -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchField" promptText="Search team..." prefWidth="220" />
                <ComboBox fx:id="gameFilter" promptText="All Games" prefWidth="180" />
                <ComboBox fx:id="levelFilter" promptText="All Levels" prefWidth="160" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="totalLabel" text="" styleClass="muted" />
            </children>
        </HBox>

        <!-- Rankings table -->
        <TableView fx:id="rankTable" VBox.vgrow="ALWAYS" styleClass="card">
            <columns>
                <TableColumn fx:id="rankCol"    text="#"          prefWidth="55" />
                <TableColumn fx:id="medalCol"   text=""           prefWidth="40" />
                <TableColumn fx:id="nameCol"    text="Team"       prefWidth="200" />
                <TableColumn fx:id="gameCol"    text="Game"       prefWidth="150" />
                <TableColumn fx:id="levelCol"   text="Level"      prefWidth="120" />
                <TableColumn fx:id="countryCol" text="Country"    prefWidth="130" />
                <TableColumn fx:id="scoreCol"   text="Score"      prefWidth="100" />
                <TableColumn fx:id="trendCol"   text="Trend"      prefWidth="80" />
            </columns>
        </TableView>

    </children>
</VBox>
