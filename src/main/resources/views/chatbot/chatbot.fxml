<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.ChatbotController" style="-fx-background-color: linear-gradient(to bottom right, #070d1a, #0d1325 45%, #111827 100%);">
    <top>
        <HBox spacing="10" style="-fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-background-color: transparent;">
            <Label text="Assistant Budget IA" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #e7edf8;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Budget, dépenses, prévisions" style="-fx-text-fill: #94a3b8;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 16px;">
            <TextArea fx:id="chatDisplayArea" editable="false" wrapText="true" style="-fx-control-inner-background: #0f1724; -fx-text-fill: #e7edf8; -fx-font-size: 13;" VBox.vgrow="ALWAYS" />
            <HBox spacing="8">
                <TextField fx:id="chatInputField" promptText="Posez votre question sur le budget..." HBox.hgrow="ALWAYS" />
                <Button fx:id="chatSendBtn" text="Envoyer" onAction="#onChatSend" styleClass="btn-primary" />
            </HBox>
            <HBox spacing="8">
                <Button text="Exemples" onAction="#onShowExamples" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Effacer" onAction="#onClearChat" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-padding: 10px; -fx-alignment: CENTER_RIGHT;">
            <Label text="© 2026 Assistant Budget IA" styleClass="muted" />
        </HBox>
    </bottom>
</BorderPane>