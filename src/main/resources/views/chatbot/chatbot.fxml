<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.chatbot.ChatbotController" spacing="10" styleClass="card">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <children>
        <Label text="Punition Advisor" styleClass="section-title" />

        <ScrollPane fitToWidth="true" prefHeight="380">
            <content>
                <VBox fx:id="messagesBox" spacing="8" />
            </content>
        </ScrollPane>

        <HBox spacing="8">
            <children>
                <TextField fx:id="inputField" promptText="Describe the incident or ask for a recommendation" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" text="Send" onAction="#onSend" />
            </children>
        </HBox>
    </children>
</VBox>

