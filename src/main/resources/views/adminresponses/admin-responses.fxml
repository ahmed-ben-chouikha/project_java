<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.adminresponses.AdminResponsesController" spacing="12" styleClass="page-root">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <children>
        <Label text="Admin Responses" styleClass="page-title" />

        <HBox spacing="12" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchField" promptText="Search by message or reclamation id..." HBox.hgrow="ALWAYS" styleClass="search-field" />
                <Button text="✉ SEND NEW RESPONSE" onAction="#onOpenCreatePopup" styleClass="ai-agent-btn" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="card">
            <content>
                <VBox fx:id="responseCardsBox" spacing="10" styleClass="admin-response-cards-panel">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                </VBox>
            </content>
        </ScrollPane>

        <HBox spacing="8">
            <children>
                <Button text="✎" onAction="#onUpdateResponse" styleClass="btn-primary icon-button" />
                <Button text="🗑" onAction="#onDeleteResponse" styleClass="btn-danger icon-button" />
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>

