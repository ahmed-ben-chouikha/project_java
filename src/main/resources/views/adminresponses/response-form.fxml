<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="ai-popup-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
    <children>
        <VBox spacing="5">
            <children>
                <Label fx:id="formTitle" id="formTitle" text="Admin Response" styleClass="ai-header-title" />
                <Label text="Respond to the player's reclamation" styleClass="ai-header-subtitle" />
            </children>
        </VBox>

        <VBox spacing="15">
            <children>
                <VBox spacing="5">
                    <children>
                        <Label text="TARGET RECLAMATION" styleClass="ai-metric-label" />
                        <ComboBox fx:id="reclamationCombo" promptText="Select reference" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                
                <VBox spacing="5">
                    <children>
                        <Label text="PREDEFINED REJECTION REASONS (AUTO-REJECT)" styleClass="ai-metric-label" />
                        <ComboBox fx:id="predefinedCombo" promptText="Optional: Select a quick reason..." maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                
                <VBox spacing="5">
                    <children>
                        <Label text="RESPONSE MESSAGE" styleClass="ai-metric-label" />
                        <TextArea fx:id="messageArea" promptText="Write your response here..." prefRowCount="5" wrapText="true" styleClass="ai-metric-value" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="cancelButton" id="cancelButton" text="DISCARD" styleClass="ai-close-btn" style="-fx-background-color: #334155; -fx-text-fill: white;" />
                <Button fx:id="submitButton" id="submitButton" text="SEND RESPONSE" styleClass="ai-finish-btn" />
            </children>
        </HBox>
    </children>
</VBox>
