<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="ai-popup-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
    <children>
        <VBox spacing="5">
            <children>
                <Label fx:id="formTitle" id="formTitle" text="Create Reclamation" styleClass="ai-header-title" />
                <Label text="Please provide the details below" styleClass="ai-header-subtitle" />
            </children>
        </VBox>

        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" />
                <ColumnConstraints percentWidth="50" />
            </columnConstraints>
            <children>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label text="TITRE" styleClass="ai-metric-label" />
                        <TextField fx:id="titreField" promptText="Enter title..." styleClass="ai-metric-value" />
                    </children>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label text="TYPE" styleClass="ai-metric-label" />
                        <ComboBox fx:id="typeCombo" promptText="Select type" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <children>
                        <Label text="PLAYER" styleClass="ai-metric-label" />
                        <ComboBox fx:id="playerIdCombo" promptText="Select player" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="ATTACHMENT" styleClass="ai-metric-label" />
                        <TextField fx:id="attachmentField" promptText="Filename..." styleClass="ai-metric-value" />
                    </children>
                </VBox>
                
                <VBox fx:id="etatBox" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Label text="ETAT" styleClass="ai-metric-label" />
                        <ComboBox fx:id="etatCombo" id="etatCombo" promptText="Select state..." maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                    <children>
                        <Label text="DESCRIPTION" styleClass="ai-metric-label" />
                        <TextArea fx:id="descriptionArea" promptText="Explain the issue..." prefRowCount="4" wrapText="true" styleClass="ai-metric-value" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="cancelButton" id="cancelButton" text="CANCEL" styleClass="ai-close-btn" style="-fx-background-color: #334155; -fx-text-fill: white;" />
                <Button fx:id="submitButton" id="submitButton" text="SUBMIT" styleClass="ai-finish-btn" />
            </children>
        </HBox>
    </children>
</VBox>
