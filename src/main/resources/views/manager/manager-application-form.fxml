<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.manager.ManagerApplicationController" spacing="12" styleClass="page-root">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <children>
        <Label text="Apply To Be Team Manager" styleClass="page-title" />
        <Label text="Fill the form below to submit a manager application. Admins will review and respond." styleClass="muted" wrapText="true" />

        <Label text="Team Name" />
        <TextField fx:id="teamNameField" promptText="Enter the team name you want to manage" />

        <Label text="Why should you be manager? (motivation)" />
        <TextArea fx:id="motivationArea" prefRowCount="6" wrapText="true" />

        <HBox spacing="10">
            <children>
                <Button text="Submit Application" onAction="#onSubmit" styleClass="btn-primary" />
                <Button text="Cancel" onAction="#onCancel" styleClass="btn-secondary" />
            </children>
        </HBox>

        <Label fx:id="statusLabel" text="" styleClass="muted" />
    </children>
</VBox>
