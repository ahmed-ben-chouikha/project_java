<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.connexion3a36.rankup.controllers.manager.TeamScoutingController"
      spacing="16" styleClass="page-root">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <children>
        <VBox spacing="6" styleClass="card">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>
                <Label text="AI Team Scouting" styleClass="page-title" />
                <Label text="Generate a 5-player formation and invite the full squad at once." styleClass="page-subtitle" wrapText="true" />
                <Label fx:id="teamNameLabel" text="Select a team" styleClass="section-title" />
                <Label fx:id="teamInfoLabel" text="" styleClass="muted" />
            </children>
        </VBox>

        <HBox spacing="12">
            <children>
                <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <children>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Your Teams" styleClass="section-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Generate Formation" onAction="#onRecommendPlayers" styleClass="btn-primary" />
                            </children>
                        </HBox>
                        <TableView fx:id="teamTable" prefHeight="240">
                            <columns>
                                <TableColumn fx:id="teamIdCol" text="ID" prefWidth="70" />
                                <TableColumn fx:id="teamNameCol" text="Team Name" prefWidth="180" />
                                <TableColumn fx:id="teamGameCol" text="Game" prefWidth="140" />
                                <TableColumn fx:id="teamLevelCol" text="Level" prefWidth="110" />
                                <TableColumn fx:id="teamStatusCol" text="Status" prefWidth="120" />
                                <TableColumn fx:id="teamScoreCol" text="Score" prefWidth="90" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <children>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Recommended Players" styleClass="section-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Invite All 5" onAction="#onInviteAll" styleClass="btn-primary" fx:id="inviteAllButton" />
                            </children>
                        </HBox>
                        <TableView fx:id="recommendedTable" prefHeight="240">
                            <columns>
                                <TableColumn fx:id="playerIdCol" text="ID" prefWidth="60" />
                                <TableColumn fx:id="playerNameCol" text="Player" prefWidth="220" />
                                <TableColumn fx:id="playerRoleCol" text="Role" prefWidth="120" />
                                <TableColumn fx:id="playerStatusCol" text="Status" prefWidth="110" />
                                <TableColumn fx:id="playerTeamCol" text="Team" prefWidth="110" />
                                <TableColumn fx:id="playerBirthCol" text="Birth" prefWidth="100" />
                                <TableColumn fx:id="playerActionsCol" text="Action" prefWidth="100" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="8" styleClass="card">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <children>
                <Label text="Formation" styleClass="section-title" />
                <Label fx:id="formationLabel" text="No formation generated yet." styleClass="muted" wrapText="true" />
                <Label fx:id="aiStatusLabel" text="" styleClass="muted" wrapText="true" />
                <Label fx:id="inviteStatusLabel" text="" styleClass="muted" wrapText="true" />
            </children>
        </VBox>

        <VBox spacing="8" styleClass="card">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Search &amp; Invite by Name" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="playerSearchField" promptText="Enter player name..." HBox.hgrow="ALWAYS" onKeyPressed="#onSearchKeyPressed" />
                        <Button text="Search" onAction="#onSearchPlayer" styleClass="btn-primary" />
                    </children>
                </HBox>
                <TableView fx:id="searchResultsTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="searchPlayerIdCol" text="ID" prefWidth="60" />
                        <TableColumn fx:id="searchPlayerNameCol" text="Player" prefWidth="220" />
                        <TableColumn fx:id="searchPlayerRoleCol" text="Role" prefWidth="120" />
                        <TableColumn fx:id="searchPlayerStatusCol" text="Status" prefWidth="110" />
                        <TableColumn fx:id="searchPlayerTeamCol" text="Team" prefWidth="110" />
                        <TableColumn fx:id="searchPlayerActionsCol" text="Action" prefWidth="100" />
                    </columns>
                </TableView>
                <Label fx:id="searchStatusLabel" text="" styleClass="muted" wrapText="true" />
            </children>
        </VBox>

        <VBox spacing="8" styleClass="card">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <children>
                <Button fx:id="backButton" text="Back to My Teams" onAction="#onBack" styleClass="btn-secondary" />
            </children>
        </VBox>
    </children>
</VBox>
