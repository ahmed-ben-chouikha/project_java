<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.PlayerProfileController" spacing="12" styleClass="page-root">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <children>
        <HBox spacing="12" styleClass="card"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding><children>
            <Label text="[Avatar]" styleClass="avatar-placeholder" />
            <VBox spacing="4"><children>
                <Label fx:id="userNameLabel" text="" styleClass="page-title" />
                <Label fx:id="userDetailsLabel" text="" />
            </children></VBox>
        </children></HBox>

        <GridPane hgap="12" vgap="12">
            <children>
                <VBox styleClass="stat-card" GridPane.columnIndex="0"><children><Label fx:id="matchesLabel" text="0" styleClass="stat-value"/><Label text="Total Matches"/></children></VBox>
                <VBox styleClass="stat-card" GridPane.columnIndex="1"><children><Label fx:id="winRateLabel" text="0%" styleClass="stat-value"/><Label text="Win Rate"/></children></VBox>
                <VBox styleClass="stat-card" GridPane.columnIndex="2"><children><Label fx:id="kdaLabel" text="0.0" styleClass="stat-value"/><Label text="Average KDA"/></children></VBox>
                <VBox styleClass="stat-card" GridPane.columnIndex="3"><children><Label fx:id="mvpLabel" text="0" styleClass="stat-value"/><Label text="MVP Count"/></children></VBox>
            </children>
        </GridPane>

        <Label text="Recent Matches" styleClass="section-title" />
        <TableView fx:id="recentMatchesTable" VBox.vgrow="ALWAYS" styleClass="card"><columns>
            <TableColumn text="Match" prefWidth="280" />
            <TableColumn text="Result" prefWidth="120" />
            <TableColumn text="KDA" prefWidth="120" />
            <TableColumn text="Points" prefWidth="120" />
        </columns></TableView>

        <Label text="Teams Joined" styleClass="section-title" />
        <ListView fx:id="teamsListView" prefHeight="100" styleClass="card" />
        <Button text="✏️ Edit Profile" onAction="#onEdit" styleClass="btn-primary" />
    </children>
</VBox>