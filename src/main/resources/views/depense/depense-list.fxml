<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.DepenseController" style="-fx-background-color: linear-gradient(to bottom right, #070d1a, #0d1325 45%, #111827 100%);">
    <top>
        <VBox style="-fx-padding: 15px; -fx-spacing: 10px; -fx-background-color: transparent;">
            <HBox spacing="10">
                <Label text="Expense Management" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Ajouter Dépense" onAction="#onAddDepense" style="-fx-padding: 8px 15px; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Rechercher..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="teamFilterCombo" promptText="Filtrer équipe" prefWidth="170"/>
                <ComboBox fx:id="categoryFilterCombo" promptText="Filtrer catégorie" prefWidth="180"/>
                <ComboBox fx:id="sortCombo" promptText="Trier" prefWidth="220"/>
            </HBox>
            <HBox spacing="15" style="-fx-padding: 10px; -fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 4;">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="💰 BUDGET ALLOUÉ" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="allocatedLabel" text="0.00€" style="-fx-font-size: 16; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="📊 MONTANT UTILISÉ" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="usedLabel" text="0.00€" style="-fx-font-size: 16; -fx-text-fill: #f59e0b; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="✅ MONTANT RESTANT" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="remainingLabel" text="0.00€" style="-fx-font-size: 16; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <HBox spacing="15" style="-fx-padding: 10px; -fx-background-color: #0b1220; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 4;">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="💸 TOTAL DÉPENSES" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="totalDepensesLabel" text="0.00€" style="-fx-font-size: 16; -fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="✅ APPROUVÉES" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="depensesApproveesLabel" text="0.00€" style="-fx-font-size: 16; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="⏳ EN ATTENTE" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="depensesAttenteLabel" text="0" style="-fx-font-size: 16; -fx-text-fill: #f59e0b; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="📦 NOMBRE" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <Label fx:id="nombreDepensesLabel" text="0" style="-fx-font-size: 16; -fx-text-fill: #e7edf8; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.0" style="-fx-background-color: #070d1a; -fx-padding: 0;">
            <TableView fx:id="depenseTable" style="-fx-font-size: 11;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="titreColumn" text="Titre" prefWidth="150"/>
                    <TableColumn fx:id="montantColumn" text="Montant (€)" prefWidth="100"/>
                    <TableColumn fx:id="montantRestantColumn" text="Montant Restant (€)" prefWidth="140"/>
                    <TableColumn fx:id="categorieColumn" text="Catégorie" prefWidth="100"/>
                    <TableColumn fx:id="teamNameColumn" text="Équipe" prefWidth="120"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150"/>
                </columns>
            </TableView>
        </SplitPane>
    </center>

    <bottom>
        <HBox style="-fx-padding: 10px; -fx-background-color: transparent;" spacing="10">
            <Label text="© 2026 Expense Management System" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="Chargé" styleClass="muted"/>
        </HBox>
    </bottom>
</BorderPane>

