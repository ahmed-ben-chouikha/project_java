<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="ai-popup-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
    <children>
        <VBox spacing="5">
            <children>
                <Label fx:id="formTitle" id="formTitle" text="Configure Punition" styleClass="ai-header-title" />
                <Label text="Define the ban duration and target" styleClass="ai-header-subtitle" />
            </children>
        </VBox>

        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" />
                <ColumnConstraints percentWidth="50" />
            </columnConstraints>
            <children>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label text="START DATE" styleClass="ai-metric-label" />
                        <DatePicker fx:id="startAtPicker" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label text="END DATE" styleClass="ai-metric-label" />
                        <DatePicker fx:id="endAtPicker" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <children>
                        <Label text="BAN STATUS" styleClass="ai-metric-label" />
                        <ComboBox fx:id="statusCombo" promptText="Select type" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="RECLAMATION" styleClass="ai-metric-label" />
                        <ComboBox fx:id="reclamationCombo" promptText="Select reference" maxWidth="Infinity" styleClass="ai-metric-value" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="cancelButton" id="cancelButton" text="CANCEL" styleClass="ai-close-btn" style="-fx-background-color: #334155; -fx-text-fill: white;" />
                <Button fx:id="submitButton" id="submitButton" text="APPLY PUNITION" styleClass="ai-finish-btn" />
            </children>
        </HBox>
    </children>
</VBox>
