<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.rankup.controllers.TournamentRegistrationUserController" spacing="20" styleClass="page-root">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18" />
    </padding>
    <children>
        <Label text="Tournament Registration" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #00BCD4;" />

        <VBox spacing="16" styleClass="card">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18" />
            </padding>
            <children>
                <Label text="Registration Form" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />

                <VBox spacing="8">
                    <Label text="Player Name" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-font-weight: bold;" />
                    <TextField fx:id="playerNameField" promptText="Enter your name" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Team Name" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-font-weight: bold;" />
                    <TextField fx:id="teamNameField" promptText="Enter team name" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Team Members" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-font-weight: bold;" />
                    <TextArea fx:id="teamMembersField" promptText="Optional: player names, separated by commas" prefRowCount="3" wrapText="true" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Contact Info" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-font-weight: bold;" />
                    <TextField fx:id="contactInfoField" promptText="Optional: email or phone" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Tournament" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-font-weight: bold;" />
                    <ComboBox fx:id="tournamentComboBox" promptText="Select planned or upcoming tournament" />
                    <Label text="Only planned tournaments can be registered. Upcoming events are visible for preview." style="-fx-text-fill: #94a3b8; -fx-font-size: 10;" />
                </VBox>

                <Label fx:id="formErrorLabel" text="" wrapText="true" style="-fx-text-fill: #ef4444;" />
                <Label fx:id="successLabel" text="" wrapText="true" style="-fx-text-fill: #10b981;" />

                <HBox spacing="10">
                    <children>
                        <Button text="Submit Registration" onAction="#onRegister" styleClass="btn-primary" />
                        <Button text="Clear" onAction="#clearRegistrationForm" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="16" styleClass="card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18" />
            </padding>
            <children>
                <Label text="My Registrations" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #00BCD4;" />

                <HBox spacing="10">
                    <children>
                        <TextField fx:id="searchField" promptText="Search tournaments or teams" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="myStatusFilter" prefWidth="160" />
                        <Button text="Cancel Selected" onAction="#onCancelRegistration" styleClass="btn-danger" />
                    </children>
                </HBox>

                <TableView fx:id="myRegistrationsTable" VBox.vgrow="ALWAYS" styleClass="card">
                    <columns>
                        <TableColumn fx:id="tournamentCol" text="Tournament" prefWidth="160" />
                        <TableColumn fx:id="teamCol" text="Team Name" prefWidth="140" />
                        <TableColumn fx:id="teamMembersCol" text="Team Members" prefWidth="200" />
                        <TableColumn fx:id="contactInfoCol" text="Contact Info" prefWidth="180" />
                        <TableColumn fx:id="dateCol" text="Registered At" prefWidth="150" />
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="110" />
                    </columns>
                </TableView>

                <Label fx:id="cancelErrorLabel" text="" wrapText="true" style="-fx-text-fill: #ef4444;" />
            </children>
        </VBox>
    </children>
</VBox>
