<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.connexion3a36.rankup.controllers.ChatbotController"
            styleClass="chatbot-container"
            style="-fx-border-color: #ddd; -fx-border-width: 1; -fx-background-color: white; -fx-border-radius: 8;">

    <!-- Top Bar -->
    <top>
        <BorderPane style="-fx-background-color: #007bff; -fx-padding: 10;">
            <center>
                <Label fx:id="chatTitle" text="🤖 RankUp Guide"
                       style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </center>
            <right>
                <HBox spacing="5" style="-fx-alignment: CENTER_RIGHT;">
                    <Button fx:id="minimizeButton" text="−"
                            style="-fx-font-size: 16; -fx-padding: 0 8; -fx-text-fill: white; -fx-background-color: transparent;"
                            onAction="#minimizeChatbot" />
                    <Button fx:id="closeButton" text="✕"
                            style="-fx-font-size: 16; -fx-padding: 0 8; -fx-text-fill: white; -fx-background-color: transparent;"
                            onAction="#closeChatbot" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <!-- Chat Messages Area -->
            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" style="-fx-control-inner-background: #f8f9fa;">
                <VBox fx:id="messagesVBox" spacing="10" style="-fx-padding: 10;"/>
            </ScrollPane>

            <!-- Suggestions -->
            <Label text="Quick Suggestions:" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666;"/>
            <VBox fx:id="suggestionsBox" spacing="5" style="-fx-padding: 0 0 10 0;">
            </VBox>

            <!-- Input Area -->
            <HBox spacing="5" style="-fx-padding: 10 0 0 0;">
                <TextField fx:id="messageInput"
                           promptText="Type your question..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13; -fx-padding: 8;"/>
                <Button fx:id="sendButton" text="Send"
                        style="-fx-font-size: 13; -fx-padding: 8 15; -fx-cursor: hand;"
                        onAction="#handleSendMessage"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>

